# Copy this file to backend/.env and edit. Every setting has a sensible default (see app/config.py).
# NEVER put passwords, OAuth tokens or API keys in this file: platform credentials are added in Phases 3-4
# and are stored separately, outside the repository.

STEALTHBOT_STREAMER_NAME=StealthModeGG
STEALTHBOT_CURRENT_GAME=GTA 6
STEALTHBOT_BOT_DISPLAY_NAME=StealthBot

# Local AI (Phase 1 benchmark: the 4B model fits fully on the 4 GB GPU only with all layers forced onto it)
STEALTHBOT_PRIMARY_MODEL=qwen3:4b-instruct-2507-q4_K_M
STEALTHBOT_FALLBACK_MODEL=qwen3:1.7b
STEALTHBOT_NUM_CTX=4096
STEALTHBOT_NUM_GPU=99

# YouTube (Phase 3) - see docs\phase3-youtube-setup.md. Credentials are NOT stored here (DPAPI-encrypted by
# scripts\youtube_login.py); these are only switches and the stream to join.
# STEALTHBOT_YOUTUBE_ENABLED=true
# STEALTHBOT_YOUTUBE_VIDEO_ID=            # the live stream's video id: the part after v= in its watch URL
# STEALTHBOT_YOUTUBE_STREAMER_CHANNEL_ID= # alternative: let the bot find the streamer's live video (UC... channel id)

# Kick (Phase 4) - see docs\phase4-kick-setup.md. Credentials are NOT stored here (DPAPI-encrypted by scripts\kick_login.py).
# STEALTHBOT_KICK_ENABLED=true
# STEALTHBOT_KICK_WEBHOOK_PUBLIC_URL=https://YOUR-TUNNEL-ADDRESS/kick/webhook   # shown in the dashboard only; the real one is typed into Kick
# STEALTHBOT_KICK_WEBHOOK_PORT=8787        # the tunnel forwards here (loopback only)
# STEALTHBOT_KICK_OAUTH_PORT=8789          # sign-in redirect http://localhost:<port>/callback, registered in the Kick app
# STEALTHBOT_KICK_MESSAGE_TYPE=bot         # bot | user
# STEALTHBOT_KICK_EVENTS=chat.message.sent # also: channel.subscription.new, .renewal, .gifts, kicks.gifted

# Proactive engagement (Phase 5): the bot starts conversations when chat is quiet. All values are in seconds; defaults are the
# spec's starting values. They can also be edited live in the dashboard (saved in the database, which then wins over these).
# STEALTHBOT_PROACTIVE_ENABLED=true
# STEALTHBOT_PROACTIVE_PLATFORMS=youtube,kick     # add "simulator" only for development
# STEALTHBOT_PROACTIVE_QUIET_AFTER_S=360          # no viewer message for this long = chat is quiet
# STEALTHBOT_PROACTIVE_MIN_GAP_S=240              # minimum time since ANY bot message
# STEALTHBOT_PROACTIVE_GENERAL_MIN_S=480          # general engagement: 8-12 min
# STEALTHBOT_PROACTIVE_GENERAL_MAX_S=720
# STEALTHBOT_PROACTIVE_QUESTION_MIN_S=900         # gaming question: 15-20 min
# STEALTHBOT_PROACTIVE_QUESTION_MAX_S=1200
# STEALTHBOT_PROACTIVE_TRIVIA_MIN_S=1800          # trivia: 30-40 min
# STEALTHBOT_PROACTIVE_TRIVIA_MAX_S=2400

# Manual approval (dashboard): start with "ask me before anything is sent" switched on
# STEALTHBOT_APPROVAL_REQUIRED=false
# STEALTHBOT_APPROVAL_TIMEOUT_S=120        # a message nobody approves within this long is dropped

# Reliability (Phase 7)
# STEALTHBOT_MAX_QUEUE_AGE_S=120           # a viewer message that waited this long (AI outage, raid) is kept but not answered late
# STEALTHBOT_STATS_FLUSH_INTERVAL_S=300    # session statistics are saved this often, so a crash loses minutes, not the session
# STEALTHBOT_INCOMING_QUEUE_MAX=200        # when full, the OLDEST waiting message is dropped

# Runtime state defaults to %LOCALAPPDATA%\stealthbot (outside OneDrive). Override only if you must.
# STEALTHBOT_STATE_DIR=C:\stealthbot-state
